{
  "name": "kofc-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-node-version.mjs && vinext build",
    "cypress:install": "cypress install",
    "cypress:open": "node scripts/run-e2e.mjs --open",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/check-node-version.mjs && npx tsx src/db/migrate.ts",
    "dev": "node scripts/check-node-version.mjs && node scripts/run-dev.mjs",
    "postinstall": "npm rebuild better-sqlite3 --foreground-scripts && cypress install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "member:seed-password": "node scripts/check-node-version.mjs && npx tsx scripts/seed-member-password.ts",
    "prepare": "husky",
    "rebuild:native": "npm rebuild better-sqlite3 --foreground-scripts",
    "seed:example": "node scripts/seed-example-council.mjs",
    "start": "vinext start",
    "test:build": "node scripts/run-e2e.mjs --build-only",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:open": "node scripts/run-e2e.mjs --open"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "better-sqlite3": "$better-sqlite3",
    "lodash": "4.18.1",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "undici": "6.28.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.4",
    "@mui/icons-material": "^9.4.0",
    "@types/leaflet": "^1.9.22",
    "@uidotdev/usehooks": "^2.4.1",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "ical-generator": "^11.1.1",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "mailgun.js": "^14.0.1",
    "react": "^19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codedependant/semantic-release-docker": "^8.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@mui/material": "^9.1.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "cypress": "^16.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "react-server-dom-webpack": "^19.3.0",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.0.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vinext": "^0.2.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
